{
  "manifest_version": 3,
  "name": "tabane",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Slack in the browser, tidied: sidebar channels as a prefix tree, copy messages as Markdown, hide upsell banners, keep the workspace switcher column, open links in the browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "src/sidebar-grouping.js"
      ],
      "css": [
        "src/sidebar-grouping.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "src/copy-markdown.js"
      ],
      "css": [
        "src/copy-markdown.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "src/noise.js"
      ],
      "css": [
        "src/noise.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.slack.com/archives/*",
        "https://*.slack.com/ssb/redirect*"
      ],
      "js": [
        "src/open-in-browser.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "src/workspace-switcher.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "css": [
        "src/workspace-switcher.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib/*.js"
      ],
      "matches": [
        "https://app.slack.com/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
